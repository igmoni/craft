{
  "name": "@igmoni/craft",
  "version": "1.0.0",
  "description": "A CLI interface to scaffold your favourite architecture, databases, auth, tools in one single command/prompt.",
  "main": "./dist/cli.js",
  "bin": {
    "craft": "dist/cli.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsc --watch",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igmoni/craft.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/igmoni/craft/issues"
  },
  "homepage": "https://github.com/igmoni/craft#readme",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "execa": "^10.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
