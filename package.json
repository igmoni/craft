{
  "name": "@igmoni/craft",
  "version": "2.0.0",
  "description": "Stop setting up. Start building. A CLI to scaffold projects with frameworks, databases, auth, and developer tools.",
  "main": "./dist/index.js",
  "bin": {
    "craft": "dist/index.js"
  },
  "scripts": {
    "test": "tsc && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"tests/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"tests/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igmoni/craft.git"
  },
  "keywords": [
    "cli",
    "scaffold",
    "generator",
    "template",
    "starter",
    "react",
    "vue",
    "angular",
    "nextjs",
    "express",
    "fastify",
    "hono",
    "nestjs"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/igmoni/craft/issues"
  },
  "homepage": "https://github.com/igmoni/craft#readme",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "execa": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
